{
  "openapi": "3.1.0",
  "info": {
    "title": "Signal Correlation Service",
    "description": "Deterministic correlation rules over telematics signals. A match becomes an incident, which is scored, checked against policy, and turned into a service case directly or after a human approval.",
    "contact": {
      "name": "FleetOps AI Control Lab"
    },
    "version": "0.1.0"
  },
