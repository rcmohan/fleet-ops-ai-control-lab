    "/v1/correlation/signals": {
      "post": {
        "tags": [
          "Signal Correlation Service"
        ],
        "summary": "Record a signal and evaluate the correlation rules",
        "description": "Record a signal and evaluate the correlation rules",
        "operationId": "ingestSignal",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ingestSignalResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Replays the original response when the same request is retried.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "eventId": {
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "title": "Eventid",
                    "type": "string"
                  },
                  "vehicleId": {
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "title": "Vehicleid",
                    "type": "string"
                  },
                  "eventType": {
                    "pattern": "^[a-z][a-z0-9_]{1,47}$",
                    "title": "Eventtype",
                    "type": "string"
                  },
                  "severity": {
                    "enum": [
                      "info",
                      "warning",
                      "critical"
                    ],
                    "title": "Severity",
                    "type": "string"
                  },
                  "observedAt": {
                    "format": "date-time",
                    "title": "Observedat",
                    "type": "string"
                  },
                  "payload": {
                    "additionalProperties": true,
                    "title": "Payload",
                    "type": "object"
                  }
                },
                "required": [
                  "eventId",
                  "vehicleId",
                  "eventType",
                  "severity",
                  "observedAt"
                ],
                "title": "SignalIn",
                "type": "object"
              },
              "example": {
                "eventId": "evt_demo_003",
                "vehicleId": "veh_demo_001",
                "eventType": "diagnostic_failure",
                "severity": "critical",
                "observedAt": "2026-08-22T11:49:00Z",
                "payload": {
                  "dtcCode": "P0562"
                }
              }
            }
          }
        }
      }
    },
