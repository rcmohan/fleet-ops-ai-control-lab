    "/v1/incidents/search": {
      "post": {
        "tags": [
          "Prior Incident Search Service"
        ],
        "summary": "Search similar incidents",
        "description": "Search similar incidents",
        "operationId": "searchSimilarIncidents",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/searchSimilarIncidentsResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Replays the original response when the same request is retried.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "eventType": {
                    "pattern": "^[a-z][a-z0-9_]{1,47}$",
                    "title": "Eventtype",
                    "type": "string"
                  },
                  "symptoms": {
                    "items": {
                      "pattern": "^[a-z][a-z0-9_]{1,63}$",
                      "type": "string"
                    },
                    "maxItems": 20,
                    "title": "Symptoms",
                    "type": "array"
                  },
                  "regionCode": {
                    "anyOf": [
                      {
                        "pattern": "^[a-z0-9][a-z0-9-]{1,31}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Regioncode"
                  }
                },
                "required": [
                  "eventType"
                ],
                "title": "SearchIncidents",
                "type": "object"
              },
              "example": {
                "eventType": "battery_voltage",
                "symptoms": [
                  "low_voltage"
                ],
                "regionCode": "us-east"
              }
            }
          }
        }
      }
    },
    "/v1/incidents": {
      "post": {
        "tags": [
          "Prior Incident Search Service"
        ],
        "summary": "Index a resolved incident (sent by Case Management or an import)",
        "description": "Index a resolved incident (sent by Case Management or an import)",
        "operationId": "indexResolvedIncident",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/indexResolvedIncidentResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Replays the original response when the same request is retried.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "incidentId": {
                    "pattern": "^inc_[A-Za-z0-9_-]{1,60}$",
                    "title": "Incidentid",
                    "type": "string"
                  },
                  "sourceCaseId": {
                    "anyOf": [
                      {
                        "pattern": "^[A-Za-z0-9_-]{1,64}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Sourcecaseid"
                  },
                  "vehicleId": {
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "title": "Vehicleid",
                    "type": "string"
                  },
                  "eventType": {
                    "pattern": "^[a-z][a-z0-9_]{1,47}$",
                    "title": "Eventtype",
                    "type": "string"
                  },
                  "symptoms": {
                    "items": {
                      "pattern": "^[a-z][a-z0-9_]{1,63}$",
                      "type": "string"
                    },
                    "maxItems": 20,
                    "title": "Symptoms",
                    "type": "array"
                  },
                  "regionCode": {
                    "anyOf": [
                      {
                        "pattern": "^[a-z0-9][a-z0-9-]{1,31}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Regioncode"
                  },
                  "rootCause": {
                    "anyOf": [
                      {
                        "maxLength": 2000,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Rootcause"
                  },
                  "resolution": {
                    "maxLength": 2000,
                    "minLength": 1,
                    "title": "Resolution",
                    "type": "string"
                  },
                  "outcome": {
                    "enum": [
                      "resolved",
                      "workaround",
                      "unresolved"
                    ],
                    "title": "Outcome",
                    "type": "string"
                  },
                  "openedAt": {
                    "format": "date-time",
                    "title": "Openedat",
                    "type": "string"
                  },
                  "resolvedAt": {
                    "format": "date-time",
                    "title": "Resolvedat",
                    "type": "string"
                  }
                },
                "required": [
                  "incidentId",
                  "vehicleId",
                  "eventType",
                  "resolution",
                  "outcome",
                  "openedAt",
                  "resolvedAt"
                ],
                "title": "IndexIncident",
                "type": "object"
              },
              "example": {
                "incidentId": "inc_demo_001",
                "sourceCaseId": "case_demo_001",
                "vehicleId": "veh_demo_001",
                "eventType": "battery_voltage",
                "symptoms": [
                  "low_voltage"
                ],
                "regionCode": "us-east",
                "rootCause": "Synthetic battery aging",
                "resolution": "Battery inspected and replaced",
                "outcome": "resolved",
                "openedAt": "2026-08-22T12:00:00Z",
                "resolvedAt": "2026-08-22T15:00:00Z"
              }
            }
          }
        }
      }
    },
    "/v1/incidents/{incident_id}/resolution": {
