{
  "openapi": "3.1.0",
  "info": {
    "title": "Notification Service",
    "description": "Synthetic notification drafts, delivery attempts, and status with approval controls.",
    "contact": {
      "name": "FleetOps AI Control Lab"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Liveness",
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Readiness",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/v1/notifications/fleet-drafts": {
      "post": {
        "tags": [
          "Notification Service"
        ],
        "summary": "Draft a fleet notification",
        "description": "Draft a fleet notification",
        "operationId": "draftFleetNotification",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/draftFleetNotificationResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Replays the original response when the same request is retried.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "fleetId": {
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "title": "Fleetid",
                    "type": "string"
                  },
                  "eventId": {
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "title": "Eventid",
                    "type": "string"
                  },
                  "message": {
                    "anyOf": [
                      {
                        "maxLength": 4000,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Optional text; a summary of the event is drafted when omitted.",
                    "title": "Message"
                  }
                },
                "required": [
                  "fleetId",
                  "eventId"
                ],
                "title": "FleetDraft",
                "type": "object"
              },
              "example": {
                "fleetId": "flt_demo_001",
                "eventId": "evt_demo_001"
              }
            }
          }
        }
      }
    },
    "/v1/notifications/internal": {
      "post": {
        "tags": [
          "Notification Service"
        ],
        "summary": "Send an internal notification",
        "description": "Send an internal notification",
        "operationId": "sendInternalNotification",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/sendInternalNotificationResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Replays the original response when the same request is retried.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "teamId": {
                    "pattern": "^team_[a-z0-9_]{1,59}$",
                    "title": "Teamid",
                    "type": "string"
                  },
                  "message": {
                    "maxLength": 4000,
                    "minLength": 1,
                    "title": "Message",
                    "type": "string"
                  }
                },
                "required": [
                  "teamId",
                  "message"
                ],
                "title": "InternalNotification",
                "type": "object"
              },
              "example": {
                "teamId": "team_ops",
                "message": "Synthetic internal notification"
              }
            }
          }
        }
      }
    },
    "/v1/notifications/fleet-manager": {
      "post": {
        "tags": [
          "Notification Service"
        ],
        "summary": "Send an approved fleet-manager notification",
        "description": "Send an approved fleet-manager notification",
        "operationId": "sendFleetManagerNotification",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/sendFleetManagerNotificationResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Replays the original response when the same request is retried.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "fleetId": {
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "title": "Fleetid",
                    "type": "string"
                  },
                  "message": {
                    "maxLength": 4000,
                    "minLength": 1,
                    "title": "Message",
                    "type": "string"
                  },
                  "approvalId": {
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "title": "Approvalid",
                    "type": "string"
                  }
                },
                "required": [
                  "fleetId",
                  "message",
                  "approvalId"
                ],
                "title": "FleetManagerNotification",
                "type": "object"
              },
              "example": {
                "fleetId": "flt_demo_001",
                "message": "Synthetic customer notification",
                "approvalId": "apr_demo_001"
              }
            }
          }
        }
      }
    },
    "/v1/notifications/{notification_id}": {
      "get": {
        "tags": [
          "Notification Service"
        ],
        "summary": "Get notification status",
        "description": "Get notification status",
        "operationId": "getNotificationStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/getNotificationStatusResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "notification_id",
            "in": "path",
            "required": true,
            "description": "",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false
      }
    }
  },
