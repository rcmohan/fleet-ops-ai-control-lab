      "post": {
        "tags": [
          "Service Provider Master Service"
        ],
        "summary": "Create a synthetic service provider",
        "description": "Create a synthetic service provider",
        "operationId": "createServiceProvider",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/createServiceProviderResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Replays the original response when the same request is retried.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "providerId": {
                    "anyOf": [
                      {
                        "pattern": "^sp_[a-z0-9_]{1,61}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Optional caller-chosen ID for imports; generated when omitted.",
                    "title": "Providerid"
                  },
                  "providerName": {
                    "maxLength": 160,
                    "minLength": 1,
                    "title": "Providername",
                    "type": "string"
                  },
                  "lifecycleStatus": {
                    "default": "active",
                    "enum": [
                      "active",
                      "at_capacity",
                      "suspended",
                      "closed"
                    ],
                    "title": "Lifecyclestatus",
                    "type": "string"
                  },
                  "averageResponseMinutes": {
                    "anyOf": [
                      {
                        "minimum": 0,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Averageresponseminutes"
                  },
                  "dailyCapacity": {
                    "anyOf": [
                      {
                        "minimum": 0,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Dailycapacity"
                  },
                  "regions": {
                    "items": {
                      "pattern": "^[a-z0-9][a-z0-9-]{1,31}$",
                      "type": "string"
                    },
                    "maxItems": 32,
                    "title": "Regions",
                    "type": "array"
                  },
                  "capabilities": {
                    "items": {
                      "pattern": "^[a-z][a-z0-9_]{1,63}$",
                      "type": "string"
                    },
                    "maxItems": 32,
                    "title": "Capabilities",
                    "type": "array"
                  }
                },
                "required": [
                  "providerName"
                ],
                "title": "CreateProvider",
                "type": "object"
              },
              "example": {
                "providerName": "Synthetic Service Network East",
                "regions": [
                  "us-east"
                ],
                "capabilities": [
                  "battery",
                  "diagnostics"
                ]
              }
            }
          }
        }
      }
    },
