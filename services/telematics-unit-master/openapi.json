    "/v1/telematics-units": {
      "post": {
        "tags": [
          "Telematics Unit Master Service"
        ],
        "summary": "Create a synthetic telematics unit",
        "description": "Create a synthetic telematics unit",
        "operationId": "createTelematicsUnit",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/createTelematicsUnitResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Replays the original response when the same request is retried.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "unitId": {
                    "anyOf": [
                      {
                        "pattern": "^tcu_[a-z0-9_]{1,60}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Optional caller-chosen ID for imports; generated when omitted.",
                    "title": "Unitid"
                  },
                  "serialNumber": {
                    "maxLength": 96,
                    "minLength": 1,
                    "title": "Serialnumber",
                    "type": "string"
                  },
                  "hardwareModel": {
                    "maxLength": 80,
                    "minLength": 1,
                    "title": "Hardwaremodel",
                    "type": "string"
                  },
                  "firmwareVersion": {
                    "pattern": "^[0-9A-Za-z.+_-]{1,64}$",
                    "title": "Firmwareversion",
                    "type": "string"
                  },
                  "activationDate": {
                    "anyOf": [
                      {
                        "format": "date",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Activationdate"
                  },
                  "networkCarrier": {
                    "anyOf": [
                      {
                        "maxLength": 80,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Networkcarrier"
                  },
                  "lifecycleStatus": {
                    "default": "inventory",
                    "enum": [
                      "inventory",
                      "active",
                      "suspended",
                      "decommissioned"
                    ],
                    "title": "Lifecyclestatus",
                    "type": "string"
                  },
                  "remoteCommandEligibility": {
                    "default": "not_eligible",
                    "enum": [
                      "eligible",
                      "approval_required",
                      "not_eligible"
                    ],
                    "title": "Remotecommandeligibility",
                    "type": "string"
                  },
                  "capabilities": {
                    "items": {
                      "pattern": "^[a-z][a-z0-9_]{1,63}$",
                      "type": "string"
                    },
                    "maxItems": 32,
                    "title": "Capabilities",
                    "type": "array"
                  }
                },
                "required": [
                  "serialNumber",
                  "hardwareModel",
                  "firmwareVersion"
                ],
                "title": "CreateUnit",
                "type": "object"
              },
              "example": {
                "serialNumber": "TCU-SYNTH-0001",
                "hardwareModel": "NX-5G",
                "firmwareVersion": "3.4.1"
              }
            }
          }
        }
      }
    },
