                    "title": "Eventid",
                    "type": "string"
                  },
                  "vehicleId": {
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "title": "Vehicleid",
                    "type": "string"
                  },
                  "eventType": {
                    "pattern": "^[a-z][a-z0-9_]{1,47}$",
                    "title": "Eventtype",
                    "type": "string"
                  },
                  "severity": {
                    "enum": [
                      "info",
                      "warning",
                      "critical"
                    ],
                    "title": "Severity",
                    "type": "string"
                  },
                  "observedAt": {
                    "format": "date-time",
                    "title": "Observedat",
                    "type": "string"
                  },
                  "payload": {
                    "additionalProperties": true,
                    "title": "Payload",
                    "type": "object"
                  }
                },
                "required": [
                  "eventId",
                  "vehicleId",
                  "eventType",
                  "severity",
                  "observedAt"
                ],
                "title": "ApplyEvent",
                "type": "object"
              },
              "example": {
                "eventId": "evt_demo_001",
                "vehicleId": "veh_demo_001",
                "eventType": "battery_voltage",
                "severity": "warning",
                "observedAt": "2026-08-22T12:00:00Z",
                "payload": {
                  "voltage": 11.6
                }
              }
            }
          }
        }
      }
    }
