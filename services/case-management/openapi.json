    "/v1/cases": {
      "post": {
        "tags": [
          "Case Management Service"
        ],
        "summary": "Create a service case",
        "description": "Create a service case",
        "operationId": "createServiceCase",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/createServiceCaseResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Replays the original response when the same request is retried.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "vehicleId": {
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "title": "Vehicleid",
                    "type": "string"
                  },
                  "summary": {
                    "maxLength": 4000,
                    "minLength": 1,
                    "title": "Summary",
                    "type": "string"
                  },
                  "recommendationId": {
                    "anyOf": [
                      {
                        "pattern": "^[A-Za-z0-9_-]{1,64}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Recommendationid"
                  },
                  "eventType": {
                    "anyOf": [
                      {
                        "pattern": "^[a-z][a-z0-9_]{1,47}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Eventtype"
                  },
                  "symptoms": {
                    "items": {
                      "pattern": "^[a-z][a-z0-9_]{1,63}$",
                      "type": "string"
                    },
                    "maxItems": 20,
                    "title": "Symptoms",
                    "type": "array"
                  },
                  "regionCode": {
                    "anyOf": [
                      {
                        "pattern": "^[a-z0-9][a-z0-9-]{1,31}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Regioncode"
                  },
                  "assignedTeamId": {
                    "anyOf": [
                      {
                        "pattern": "^team_[a-z0-9_]{1,59}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Assignedteamid"
                  },
                  "traceId": {
                    "anyOf": [
                      {
                        "pattern": "^[A-Za-z0-9_-]{1,64}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Traceid"
                  }
                },
                "required": [
                  "vehicleId",
                  "summary"
                ],
                "title": "CreateCase",
                "type": "object"
              },
              "example": {
                "vehicleId": "veh_demo_001",
                "recommendationId": "rec_demo_001",
                "summary": "Inspect low battery voltage"
              }
            }
          }
        }
      }
    },
    "/v1/cases/{case_id}/status": {
      "put": {
        "tags": [
          "Case Management Service"
        ],
        "summary": "Update case status",
        "description": "Update case status",
        "operationId": "updateCase",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/updateCaseResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "description": "",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "open",
                      "in_progress",
                      "resolved",
                      "closed",
                      "cancelled"
                    ],
                    "title": "Status",
                    "type": "string"
                  },
                  "comment": {
                    "anyOf": [
                      {
                        "maxLength": 2000,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Comment"
                  },
                  "resolution": {
                    "anyOf": [
                      {
                        "maxLength": 4000,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Required when resolving.",
                    "title": "Resolution"
                  },
                  "rootCause": {
                    "anyOf": [
                      {
                        "maxLength": 4000,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Rootcause"
                  },
                  "outcome": {
                    "default": "resolved",
                    "enum": [
                      "resolved",
                      "workaround",
                      "unresolved"
                    ],
                    "title": "Outcome",
                    "type": "string"
                  }
                },
                "required": [
                  "status"
                ],
                "title": "StatusChange",
                "type": "object"
              },
              "example": {
                "status": "in_progress",
                "comment": "Battery inspection booked"
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Case Management Service"
        ],
        "summary": "Get case status",
        "description": "Get case status",
        "operationId": "getCaseStatus",
