    "/v1/maintenance-records": {
      "post": {
        "tags": [
          "Maintenance History Service"
        ],
        "summary": "Record a maintenance event",
        "description": "Record a maintenance event",
        "operationId": "recordMaintenanceEvent",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/recordMaintenanceEventResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Replays the original response when the same request is retried.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "maintenanceId": {
                    "anyOf": [
                      {
                        "pattern": "^mtn_[a-z0-9_]{1,60}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Optional caller-chosen ID for imports; generated when omitted.",
                    "title": "Maintenanceid"
                  },
                  "vehicleId": {
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "title": "Vehicleid",
                    "type": "string"
                  },
                  "serviceProviderId": {
                    "anyOf": [
                      {
                        "pattern": "^[A-Za-z0-9_-]{1,64}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Serviceproviderid"
                  },
                  "eventType": {
                    "enum": [
                      "inspection",
                      "preventive",
                      "repair",
                      "recall",
                      "diagnostic",
                      "other"
                    ],
                    "title": "Eventtype",
                    "type": "string"
                  },
                  "serviceStatus": {
                    "enum": [
                      "scheduled",
                      "in_progress",
                      "completed",
                      "cancelled"
                    ],
                    "title": "Servicestatus",
                    "type": "string"
                  },
                  "openedAt": {
                    "format": "date-time",
                    "title": "Openedat",
                    "type": "string"
                  },
                  "completedAt": {
                    "anyOf": [
                      {
                        "format": "date-time",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Completedat"
                  },
                  "odometerKm": {
                    "anyOf": [
                      {
                        "minimum": 0,
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Odometerkm"
                  },
                  "summary": {
                    "maxLength": 2000,
                    "minLength": 1,
                    "title": "Summary",
                    "type": "string"
                  },
                  "resolution": {
                    "anyOf": [
                      {
                        "maxLength": 2000,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Resolution"
                  },
                  "sourceReference": {
                    "anyOf": [
                      {
                        "maxLength": 128,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Sourcereference"
                  }
                },
                "required": [
                  "vehicleId",
                  "eventType",
                  "serviceStatus",
                  "openedAt",
                  "summary"
                ],
                "title": "RecordEvent",
                "type": "object"
              },
              "example": {
                "vehicleId": "veh_demo_001",
                "serviceProviderId": "sp_demo_001",
                "eventType": "preventive",
                "serviceStatus": "completed",
                "openedAt": "2026-08-01T09:00:00Z",
                "summary": "Synthetic scheduled inspection"
              }
            }
          }
        }
      }
    },
    "/v1/maintenance-records/{maintenance_id}/corrections": {
      "post": {
        "tags": [
          "Maintenance History Service"
        ],
        "summary": "Append a maintenance correction",
        "description": "Append a maintenance correction",
        "operationId": "correctMaintenanceRecord",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/correctMaintenanceRecordResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "maintenance_id",
            "in": "path",
            "required": true,
            "description": "",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Replays the original response when the same request is retried.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "reason": {
                    "maxLength": 1000,
                    "minLength": 1,
                    "title": "Reason",
                    "type": "string"
                  },
                  "changes": {
                    "additionalProperties": false,
                    "properties": {
                      "serviceProviderId": {
                        "anyOf": [
                          {
                            "pattern": "^[A-Za-z0-9_-]{1,64}$",
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Serviceproviderid"
                      },
                      "eventType": {
                        "enum": [
                          "inspection",
                          "preventive",
                          "repair",
                          "recall",
                          "diagnostic",
                          "other"
                        ],
                        "title": "Eventtype",
                        "type": "string"
                      },
                      "serviceStatus": {
                        "enum": [
                          "scheduled",
                          "in_progress",
                          "completed",
                          "cancelled"
                        ],
                        "title": "Servicestatus",
                        "type": "string"
                      },
                      "openedAt": {
                        "format": "date-time",
                        "title": "Openedat",
                        "type": "string"
                      },
                      "completedAt": {
                        "anyOf": [
                          {
                            "format": "date-time",
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Completedat"
                      },
                      "odometerKm": {
                        "anyOf": [
                          {
                            "minimum": 0,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Odometerkm"
                      },
                      "summary": {
                        "maxLength": 2000,
                        "minLength": 1,
                        "title": "Summary",
                        "type": "string"
                      },
                      "resolution": {
                        "anyOf": [
                          {
                            "maxLength": 2000,
                            "minLength": 1,
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Resolution"
                      }
                    },
                    "title": "CorrectionChanges",
                    "type": "object"
                  }
                },
                "required": [
                  "reason",
                  "changes"
                ],
                "title": "Correction",
                "type": "object"
              },
              "example": {
                "reason": "Synthetic data correction",
                "changes": {
                  "odometerKm": 15000.0
                }
              }
            }
          }
        }
      }
    }
