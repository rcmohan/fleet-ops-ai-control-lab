    "/v1/approvals": {
      "post": {
        "tags": [
          "Approval Service"
        ],
        "summary": "Request human approval",
        "description": "Request human approval",
        "operationId": "requestHumanApproval",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/requestHumanApprovalResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Replays the original response when the same request is retried.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "actionId": {
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "title": "Actionid",
                    "type": "string"
                  },
                  "actionType": {
                    "pattern": "^[a-z][a-z0-9_]{1,63}$",
                    "title": "Actiontype",
                    "type": "string"
                  },
                  "riskLevel": {
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "critical"
                    ],
                    "title": "Risklevel",
                    "type": "string"
                  },
                  "evidenceTraceId": {
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "title": "Evidencetraceid",
                    "type": "string"
                  },
                  "requestedReviewerRole": {
                    "pattern": "^[a-z][a-z0-9_]{1,63}$",
                    "title": "Requestedreviewerrole",
                    "type": "string"
                  },
                  "expiresInSeconds": {
                    "default": 3600,
                    "maximum": 604800,
                    "minimum": 60,
                    "title": "Expiresinseconds",
                    "type": "integer"
                  }
                },
                "required": [
                  "actionId",
                  "actionType",
                  "riskLevel",
                  "evidenceTraceId",
                  "requestedReviewerRole"
                ],
                "title": "ApprovalRequest",
                "type": "object"
              },
              "example": {
                "actionId": "act_demo_001",
                "actionType": "fleet_notification",
                "riskLevel": "high",
                "evidenceTraceId": "trace_demo_001",
                "requestedReviewerRole": "operations_manager",
                "expiresInSeconds": 3600
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Approval Service"
        ],
        "summary": "List pending approvals for a reviewer",
        "description": "List pending approvals for a reviewer",
        "operationId": "listPendingApprovals",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
