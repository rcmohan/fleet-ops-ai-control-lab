    "/v1/approvals/{approval_id}/decisions": {
      "post": {
        "tags": [
          "Approval Service"
        ],
        "summary": "Record an approval decision",
        "description": "Record an approval decision",
        "operationId": "recordApprovalDecision",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/recordApprovalDecisionResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Reviewer-Id",
            "in": "header",
            "required": true,
            "description": "Synthetic reviewer identity; not authenticated",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "approval_id",
            "in": "path",
            "required": true,
            "description": "",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Replays the original response when the same request is retried.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "decision": {
                    "enum": [
                      "approved",
                      "rejected"
                    ],
                    "title": "Decision",
                    "type": "string"
                  },
                  "comments": {
                    "anyOf": [
                      {
                        "maxLength": 4000,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Comments"
                  }
                },
                "required": [
                  "decision"
                ],
                "title": "Decision",
                "type": "object"
              },
              "example": {
                "decision": "approved",
                "comments": "Approved for synthetic execution"
              }
            }
          }
        }
      }
    }
  },
