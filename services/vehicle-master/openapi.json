                    "enum": [
                      "low",
                      "standard",
                      "high",
                      "critical"
                    ],
                    "title": "Prioritylevel",
                    "type": "string"
                  }
                },
                "title": "UpdateVehicle",
                "type": "object"
              },
              "example": {
                "regionCode": "us-east",
                "priorityLevel": "high"
              }
