    "/v1/vehicles": {
      "post": {
        "tags": [
          "Vehicle Master Service"
        ],
        "summary": "Create a synthetic vehicle",
        "description": "Create a synthetic vehicle",
        "operationId": "createVehicle",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/createVehicleResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Replays the original response when the same request is retried.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "vehicleId": {
                    "anyOf": [
                      {
                        "pattern": "^veh_[a-z0-9_]{1,60}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Optional caller-chosen ID for imports; generated when omitted.",
                    "title": "Vehicleid"
                  },
                  "syntheticVin": {
                    "pattern": "^[A-Z0-9]{11,17}$",
                    "title": "Syntheticvin",
                    "type": "string"
                  },
                  "make": {
                    "maxLength": 80,
                    "minLength": 1,
                    "title": "Make",
                    "type": "string"
                  },
                  "model": {
                    "maxLength": 80,
                    "minLength": 1,
                    "title": "Model",
                    "type": "string"
                  },
                  "modelYear": {
                    "maximum": 2200,
                    "minimum": 1980,
                    "title": "Modelyear",
                    "type": "integer"
                  },
                  "powertrainType": {
                    "enum": [
                      "gasoline",
                      "diesel",
                      "hybrid",
                      "plug_in_hybrid",
                      "battery_electric",
                      "hydrogen",
                      "other"
                    ],
                    "title": "Powertraintype",
                    "type": "string"
                  },
                  "regionCode": {
                    "pattern": "^[a-z0-9][a-z0-9-]{1,31}$",
                    "title": "Regioncode",
                    "type": "string"
                  },
                  "lifecycleStatus": {
                    "default": "active",
                    "enum": [
                      "ordered",
                      "active",
                      "inactive",
                      "retired"
                    ],
                    "title": "Lifecyclestatus",
                    "type": "string"
                  },
                  "serviceStatus": {
                    "default": "in_service",
                    "enum": [
                      "in_service",
                      "maintenance",
                      "out_of_service",
                      "retired"
                    ],
                    "title": "Servicestatus",
                    "type": "string"
                  },
                  "warrantyStatus": {
                    "default": "unknown",
                    "enum": [
                      "active",
                      "expired",
                      "unknown"
                    ],
                    "title": "Warrantystatus",
                    "type": "string"
                  },
                  "priorityLevel": {
                    "default": "standard",
                    "enum": [
                      "low",
                      "standard",
                      "high",
                      "critical"
                    ],
                    "title": "Prioritylevel",
                    "type": "string"
                  },
                  "fleetId": {
                    "anyOf": [
                      {
                        "pattern": "^[A-Za-z0-9_-]{1,64}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Fleetid"
                  },
                  "telematicsUnitId": {
                    "anyOf": [
                      {
                        "pattern": "^[A-Za-z0-9_-]{1,64}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Telematicsunitid"
                  }
                },
                "required": [
                  "syntheticVin",
                  "make",
                  "model",
                  "modelYear",
                  "powertrainType",
                  "regionCode"
                ],
                "title": "CreateVehicle",
                "type": "object"
              },
              "example": {
                "syntheticVin": "SYNTH000000000001",
                "make": "Nova",
                "model": "Transit-E",
                "modelYear": 2026,
                "powertrainType": "battery_electric",
                "regionCode": "us-east"
              }
            }
          }
        }
      },
