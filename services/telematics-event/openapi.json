    "/v1/events": {
      "post": {
        "tags": [
          "Telematics Event Service"
        ],
        "summary": "Ingest a synthetic vehicle event",
        "description": "Ingest a synthetic vehicle event",
        "operationId": "ingestVehicleEvent",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ingestVehicleEventResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Replays the original response when the same request is retried.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-dummy-implementation": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "eventId": {
                    "anyOf": [
                      {
                        "pattern": "^evt_[A-Za-z0-9_-]{1,60}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Device-assigned ID. A retry with the same ID and content is a duplicate; different content is a conflict. Generated when omitted.",
                    "title": "Eventid"
                  },
                  "vehicleId": {
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "title": "Vehicleid",
                    "type": "string"
                  },
                  "eventType": {
                    "enum": [
                      "battery_voltage",
                      "heartbeat",
                      "heartbeat_missed",
                      "connectivity_lost",
                      "connectivity_restored",
                      "diagnostic_failure",
                      "diagnostic_cleared",
                      "location",
                      "harsh_braking",
                      "collision_detected",
                      "firmware_update_failed",
                      "firmware_update_succeeded",
                      "ignition_on",
                      "ignition_off"
                    ],
                    "title": "Eventtype",
                    "type": "string"
                  },
                  "observedAt": {
                    "format": "date-time",
                    "title": "Observedat",
                    "type": "string"
                  },
                  "payload": {
                    "additionalProperties": true,
                    "title": "Payload",
                    "type": "object"
                  },
                  "synthetic": {
                    "default": true,
                    "title": "Synthetic",
                    "type": "boolean"
                  },
                  "regionCode": {
                    "anyOf": [
                      {
                        "pattern": "^[a-z0-9][a-z0-9-]{1,31}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Defaults to the vehicle's region in Vehicle Master.",
                    "title": "Regioncode"
                  }
                },
                "required": [
                  "vehicleId",
                  "eventType",
                  "observedAt"
                ],
                "title": "IngestEvent",
                "type": "object"
              },
              "example": {
                "vehicleId": "veh_demo_001",
                "eventType": "battery_voltage",
                "observedAt": "2026-08-22T12:00:00Z",
                "payload": {
                  "voltage": 11.6
                },
                "synthetic": true
              }
            }
          }
        }
      },
