FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt requirements-exporter.txt ./
RUN pip install --no-cache-dir -r requirements-exporter.txt

COPY fleetops_runtime ./fleetops_runtime
COPY cloud_exporter ./cloud_exporter

EXPOSE 8080

CMD ["uvicorn", "--factory", "cloud_exporter.app:create_app", "--host", "0.0.0.0", "--port", "8080"]
